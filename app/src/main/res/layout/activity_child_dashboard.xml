<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obsidian_bg"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_emerald"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvChildWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مرحباً بك في درع سولي العائلي 🛡️"
                android:textColor="@color/text_white"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeviceUuidBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="UUID: dev_..."
                android:textColor="@color/emerald_bright"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvActiveModeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="الوضع الحالي: الوضع العادي المتوازن ⚡"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLastHeartbeatInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="آخر مزامنة مع لوحة الوالدين: متصل الآن"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_emerald"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 ملخص السياسات النشطة على الهاتف"
                android:textColor="@color/emerald_bright"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDnsFilterStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="• فلتر الـ DNS العائلي الآمن: مفعّل ✅"
                android:textColor="@color/text_white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvSafeZonesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="• النطاقات الجغرافية الآمنة المسجلة: 1 نطاق"
                android:textColor="@color/text_white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvRoutinesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="• جداول المذاكرة والنوم المبرمجة: 1 جدول"
                android:textColor="@color/text_white"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSyncNow"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/emerald_primary"
                android:text="🔄 مزامنة النبض والسياسات مع لوحة الأب فوراً"
                android:textColor="@color/obsidian_bg"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOpenPermissionsSetup"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/obsidian_surface"
                android:text="⚙️ فحص واستكمال صلاحيات النظام الخمس"
                android:textColor="@color/emerald_bright"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_emerald"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨 نداء الاستغاثة العائلي الفوري (SOS Panic)"
                android:textColor="@color/rose_danger"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="اضغط لإرسال موقعك الجغرافي الدقيق وتنبيه طوارئ فوري إلى هاتف والدك"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSendSosPanic"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/rose_danger"
                android:text="🆘 إرسال إشارة استغاثة وموقعي الحالي لوالدي"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
