<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obsidian_bg"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_emerald"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_shield_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="درع سولي للرعاية الرقمية العائلية"
                android:textColor="@color/text_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="امسح رمز الـ QR من لوحة تحكم ولي الأمر أو أدخل كود الربط المشفر"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/qrScannerContainer"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_emerald"
            android:padding="8dp">

            <androidx.camera.view.PreviewView
                android:id="@+id/cameraPreviewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/tvScannerOverlayHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:background="#AA041512"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="وجّه الكاميرا نحو رمز الـ QR للربط التلقائي"
                android:textColor="@color/emerald_bright"
                android:textSize="12sp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/pairingFormContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_emerald"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="رابط السيرفر الرئيسي (Souly Hub URL):"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="#041512"
                android:hint="https://soulyeg.online"
                android:inputType="textUri"
                android:paddingHorizontal="14dp"
                android:text="https://soulyeg.online"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_muted"
                android:textDirection="ltr"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="كود الربط المشفر (Pairing Code):"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etPairingCode"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="#041512"
                android:hint="SOULY-XXXX-1234"
                android:inputType="textCapCharacters"
                android:paddingHorizontal="14dp"
                android:textColor="@color/emerald_bright"
                android:textColorHint="@color/text_muted"
                android:textDirection="ltr"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="اسم الطفل:"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etChildName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="#041512"
                android:hint="مثال: يوسف أحمد"
                android:inputType="textPersonName"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnPairDeviceNow"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/emerald_primary"
                android:text="🔗 ربط الهاتف وتفعيل الحماية الآن"
                android:textColor="@color/obsidian_bg"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPairingStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="حالة الربط: في انتظار مسح الـ QR أو إدخال الكود"
                android:textColor="@color/amber_warning"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_emerald"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ صلاحيات النظام المطلوبة لعمل الدرع بكفاءة 100%:"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnGrantLocation"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/obsidian_surface"
                android:text="📍 1. منح صلاحية الموقع الجغرافي والإشعارات"
                android:textColor="@color/emerald_bright"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnGrantUsageStats"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/obsidian_surface"
                android:text="📊 2. منح صلاحية إحصائيات وقت استخدام التطبيقات"
                android:textColor="@color/emerald_bright"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnGrantOverlay"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/obsidian_surface"
                android:text="🪟 3. منح صلاحية الظهور فوق التطبيقات (شاشة القفل الأبوي)"
                android:textColor="@color/emerald_bright"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnGrantDeviceAdmin"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/obsidian_surface"
                android:text="🛡️ 4. تفعيل مسؤول حماية الجهاز (Device Admin)"
                android:textColor="@color/emerald_bright"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnGrantVpnDns"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/obsidian_surface"
                android:text="🌐 5. تفعيل درع الـ DNS العائلي لحظر المواقع الضارة"
                android:textColor="@color/emerald_bright"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
